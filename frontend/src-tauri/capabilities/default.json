{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Gundam Halo desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:tray:default",
    "shell:default",
    "dialog:default",
    "notification:default",
    "global-shortcut:default"
  ]
}
