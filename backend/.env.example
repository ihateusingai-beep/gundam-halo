# MiniMax API (LLM brain) — https://api.MiniMax.chat/v1
MINIMAX_API_KEY=sk-...your-key-here...
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_FALLBACK_MODEL=MiniMax-M2

# Server
HALO_HOST=0.0.0.0
HALO_PORT=8765
HALO_LOG_LEVEL=INFO

# Telegram bot (channel)
GUNDAM_HALO_TG_TOKEN=...your-telegram-bot-token...
GUNDAM_HALO_TG_ALLOWED_CHAT_IDS=123456789

# Tailscale
HALO_REQUIRE_TAILSCALE=true
HALO_TAILSCALE_HOSTNAME=gundam-halo

# Workspace (override default ~/.gundam-halo)
HALO_HOME=~/.gundam-halo

# Development
HALO_DEV_MODE=false
HALO_LOG_AUDIT=true
