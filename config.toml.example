# Gundam Halo — config.toml example
#
# Copy to ~/.gundam-halo/config.toml and edit. The backend reads this
# at startup. Environment variables (HALO_HOME, MINIMAX_API_KEY, etc.)
# override individual fields.
#
# Sprint 37.1: the `voice` extra now bundles `silero-vad` (the
# TorchScript Silero V5 backend). A cold `uv sync --extra voice`
# install is enough for the voice WS endpoint to warm up —
# no manual `uv add silero-vad` needed. Combined with Sprint 37,
# the voice layer works out of the box for the whisper_local
# ASR backend (the default `voice.asr.backend = "whisper_local"`).
# Other backends:
#   - `voice-yuesub`: Cantonese via SenseVoiceSmall. Adds
#     funasr_onnx + librosa + opencc + pandas (~1.5GB).
#   - `voice-hf`: HF transformers pipeline. Adds torch +
#     transformers + accelerate.
#   - `voice-hf-mlx`: Apple Silicon MLX whisper (2× speedup).
# Install with: uv sync --extra voice --extra voice-yuesub
# (numpy is pinned to <1.27 in the voice extra so combined
# installs resolve cleanly).

# ---------------------------------------------------------------------------
# User
# ---------------------------------------------------------------------------
[user]
name = "Ken"
default_theme = "gundam-ntd"   # 8 themes available; see docs/ARCHITECTURE.md

# ---------------------------------------------------------------------------
# LLM (brain)
# ---------------------------------------------------------------------------
[llm]
provider = "minimax"
api_key_env = "MINIMAX_API_KEY"     # read from env, NEVER stored in TOML
# Two MiniMax clusters exist:
#   - api.minimax.io    (`.io` cluster, this default)
#   - api.MiniMax.chat  (`.chat` cluster, different key scope)
# The `.io` cluster is the standard one as of 2026-06; if you
# have a `.chat` API key, change the URL accordingly.
base_url = "https://api.minimax.io/v1"
default_model = "MiniMax-M2"
fallback_model = "MiniMax-M2"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
[server]
host = "0.0.0.0"
port = 8765                        # bound, but only reachable via Tailscale
log_level = "INFO"                  # DEBUG / INFO / WARNING / ERROR
require_tailscale = true            # reject non-Tailscale connections
tailscale_hostname = "gundam-halo"
# Sprint 42: ACL setup + healthCheck JSON lives in
# docs/SECURITY-HARDENING.md. Run install.sh --with-tailscale
# for the print-on-install hint, or read the doc directly.

# ---------------------------------------------------------------------------
# Mac control pane (security-sensitive — default-deny)
# ---------------------------------------------------------------------------
[mac]
default_path_policy = "project_only"   # project_only | user_home | allowlist
shell_allowlist = [
    "git", "ls", "cat", "head", "tail",
    "grep", "rg", "find", "fd",
    "pwd", "cd", "echo", "date",
    "open",                            # `open <app>`
]
file_read_paths = ["~/Documents", "~/Downloads", "~/workspace", "/tmp"]
file_write_paths = ["~/workspace", "~/.gundam-halo/projects"]
a11y_enabled = false
apple_script_enabled = true
notifications_enabled = true

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
[channels.telegram]
enabled = false                      # set true to enable
bot_token = ""                        # or set GUNDAM_HALO_TG_TOKEN env var
# Whitelist chat_ids that can message the bot. Get yours by
# messaging @userinfobot on Telegram. Empty = accept any (NOT for prod).
allowed_chat_ids = [123456789]
command_prefix = "/"                  # default

# ---------------------------------------------------------------------------
# Voice layer (M1-M3 — see docs/ARCHITECTURE.md §15)
# ---------------------------------------------------------------------------
# Sprint 37: voice is enabled by default. Cold-install users get
# a working voice layer out of the box. The previous default
# of `false` meant /voice/status, /voice/config, and /ws/voice
# all returned 404 on first launch, which broke the dashboard's
# voice tab. To disable voice entirely, set this to `false`.
[voice]
enabled = true
sample_rate = 16000
frame_duration_ms = 250

[voice.vad]
backend = "silero"                    # silero v5
# Sprint 37: default path now points to `.jit` (TorchScript
# bundle from the `silero-vad` PyPI package). The upstream
# Silero V5 ONNX file is corrupted as of 2024-06; the only
# currently-valid V5 model is the TorchScript bundle. If you
# have a known-good `.onnx` file, set this to its path; the
# runtime will probe `.jit`/`.pt`/`.onnx` siblings in priority
# order so the exact filename doesn't matter.
model_path = "~/.gundam-halo/models/silero_vad.jit"
speech_threshold_start = 0.5
speech_threshold_end = 0.35
min_speech_ms = 250
min_silence_ms = 700

[voice.asr]
# M9-E (v0.1.3): default remains base. M9-E Layer 1 (medium
# bump) was tested and rejected — see CHANGELOG v0.1.3 — the
# 3x ASR latency penalty (5.5s → 16s on a 5s utterance) far
# outweighs the marginal Cantonese quality gain. Layer 2
# (Cantonese fine-tune of base) is the actual path forward.
backend = "whisper_local"             # v1: "whisper_local" is the only one wired in the factory
model_size = "base"                   # tiny/base/small/medium/large
device = "auto"                       # auto | cpu | mps (Apple Silicon)

[voice.tts]
backend = "edge"                      # edge (free) | pyttsx3 (offline)
voice = "zh-HK-HiuMaanNeural"         # Cantonese-leaning
# See: https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support
# Common voices: zh-CN-XiaoxiaoNeural, en-US-JennyNeural, ja-JP-NanamiNeural

[voice.live2d]
enabled = true
theme = "ntd"                         # ntd | seedfreedom | ... (more later)
default_emotion = "calm"
# Path to a Cubism .model3.json (leave empty to use the CSS avatar fallback)
model_path = ""

# ---------------------------------------------------------------------------
# Mark-XL tool imports (Sprint 27, see
# docs/FEATURE-SPEC-SPRINT27.md; Sprint 28/29 wired
# the conditional registration per
# docs/FEATURE-SPEC-SPRINT28.md). The 4 tools below
# are conditionally registered in `default_tools()`
# based on the `enabled` flag. Setting `enabled =
# false` removes the tool from the LLM's tool list
# (the LLM cannot call a tool it doesn't know about).
#
# **NOTE: changes to `enabled` take effect on
# backend restart.** The `ToolsConfig.enabled` flag
# is not runtime-tunable in v0.1.5+; a future sprint
# can add hot-reload via the existing
# `schedule_restart` pattern (Sprint 19b).
# ---------------------------------------------------------------------------

# WebSearchTool (Track 27.1) — DuckDuckGo HTML search.
# No extra dep needed (uses existing httpx).
[tools.web_search]
enabled = true
# Cap on results fetched from DDG (1-10). Default 5.
max_results = 5
# Cap on the formatted output length (chars) to keep
# the TTS response under the 60s budget. Default 800.
summary_max_chars = 800
# HTTP timeout for the DDG endpoint. Default 10s.
request_timeout_s = 10.0

# YouTubeSummarizeTool (Track 27.2) — fetch + summarize
# a YouTube video's transcript.
# Requires the optional `youtube-transcript-api` dep:
#   uv add youtube-transcript-api
# Without the dep, the tool falls back to YouTube's
# oEmbed API and returns the video's title + author.
[tools.youtube_summarize]
enabled = true
# Cap on transcript length before LLM summarisation.
# Default 12000 (matches Mark-XL).
max_transcript_chars = 12000
# Cap on the formatted output length (chars).
summary_max_chars = 800

# FlightFinderTool (Track 27.3, Sprint 30 Track B) —
# aviationstack real flight-data extractor with the
# Sprint 27 URL builder as a fallback. See the spec
# §4.2 for why the URL builder stays as the fallback.
# No extra dep needed (httpx is already in the venv).
[tools.flight_finder]
enabled = true
# Sprint 30 Track B: aviationstack access key. Leave
# empty (the default) to fall back to the Sprint 27
# URL builder. Get a free key (100 requests/month) at
# https://aviationstack.com/signup. The paid tier
# ($50/month for 10,000 requests) covers heavier use.
# Do NOT commit a real key to the repo — keep this as
# an empty string in any tracked copy.
api_key = ""
# Sprint 30 Track B: which flight API provider to use.
# Currently only "aviationstack" is wired in (per spec
# §4.2 — aviationstack is the primary API). Any value
# other than "aviationstack" falls back to the URL
# builder. "serpapi" is reserved for a future sprint.
api_provider = "aviationstack"
# Sprint 30 Track B: how many top flights to include
# in the prose summary (1-10, default 5). The free
# tier returns ≤10 flights per request, so 5 keeps
# the TTS response under the 60s voice budget.
top_n = 5

# SendMessageTool (Track 27.4) — pyautogui-based
# message sender. **OPT-IN**: requires the
# `pyautogui + mss + pygetwindow + onnxruntime` deps AND
# macOS Accessibility permission. The tool is a stub if
# these deps are missing — the user gets a clear "deps
# missing" error pointing at this extra. The YOLO model
# is downloaded on first use via
# `scripts/download_yolo_model.py` (~50MB, one-time).
# Install the deps:
#   uv sync --extra tool-send-message
[tools.send_message]
enabled = false  # OPT-IN: pyautogui is fragile
# OS family (auto-detected from sys.platform by default;
# uncomment to override):
# os_system = "darwin"  # darwin | win32 | linux
# Default messaging platform when none is specified.
default_platform = "whatsapp"
# YOLO detection confidence threshold (0-1, default 0.7).
# Lower = more lenient (catches more candidates, but more
# false positives). Sprint 30 Track A.
detection_confidence = 0.7
# Path to the bundled YOLO model (default = empty = use
# ~/.gundam-halo/models/yolov8n-messaging.onnx). Set this
# to a custom path if the user wants to use a re-trained
# version. Sprint 30 Track A.
yolo_model_path = ""
# How long to wait for the app to launch before taking
# the first screenshot (seconds, default 2.5).
app_launch_wait_s = 2.5
# Delay between typed characters (seconds, default 0.05).
# 0.05s gives the app time to process each character
# reliably; pyautogui's default is 0.0 (instant).
typing_delay_s = 0.05

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
[security]
audit_log = "~/.gundam-halo/logs/audit.log"
audit_max_size_mb = 100
injection_scan = true                 # scan inbound text for prompt injection
