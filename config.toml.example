# Gundam Halo — config.toml example
#
# Copy to ~/.gundam-halo/config.toml and edit. The backend reads this
# at startup. Environment variables (HALO_HOME, MINIMAX_API_KEY, etc.)
# override individual fields.

# ---------------------------------------------------------------------------
# User
# ---------------------------------------------------------------------------
[user]
name = "Ken"
default_theme = "gundam-ntd"   # 8 themes available; see docs/ARCHITECTURE.md

# ---------------------------------------------------------------------------
# LLM (brain)
# ---------------------------------------------------------------------------
[llm]
provider = "minimax"
api_key_env = "MINIMAX_API_KEY"     # read from env, NEVER stored in TOML
base_url = "https://api.MiniMax.chat/v1"
default_model = "MiniMax-M3"
fallback_model = "MiniMax-M2"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
[server]
host = "0.0.0.0"
port = 8765                        # bound, but only reachable via Tailscale
log_level = "INFO"                  # DEBUG / INFO / WARNING / ERROR
require_tailscale = true            # reject non-Tailscale connections
tailscale_hostname = "gundam-halo"

# ---------------------------------------------------------------------------
# Mac control pane (security-sensitive — default-deny)
# ---------------------------------------------------------------------------
[mac]
default_path_policy = "project_only"   # project_only | user_home | allowlist
shell_allowlist = [
    "git", "ls", "cat", "head", "tail",
    "grep", "rg", "find", "fd",
    "pwd", "cd", "echo", "date",
    "open",                            # `open <app>`
]
file_read_paths = ["~/Documents", "~/Downloads", "~/workspace", "/tmp"]
file_write_paths = ["~/workspace", "~/.gundam-halo/projects"]
a11y_enabled = false
apple_script_enabled = true
notifications_enabled = true

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
[channels.telegram]
enabled = false                      # set true to enable
bot_token = ""                        # or set GUNDAM_HALO_TG_TOKEN env var
# Whitelist chat_ids that can message the bot. Get yours by
# messaging @userinfobot on Telegram. Empty = accept any (NOT for prod).
allowed_chat_ids = [123456789]
command_prefix = "/"                  # default

# ---------------------------------------------------------------------------
# Voice layer (M1-M3 — see docs/ARCHITECTURE.md §15)
# ---------------------------------------------------------------------------
[voice]
enabled = false                       # set true to enable voice
sample_rate = 16000
frame_duration_ms = 250

[voice.vad]
backend = "silero"                    # silero v5
speech_threshold_start = 0.5
speech_threshold_end = 0.35
min_speech_ms = 250
min_silence_ms = 700

[voice.asr]
# M9-E (v0.1.3): default remains base. M9-E Layer 1 (medium
# bump) was tested and rejected — see CHANGELOG v0.1.3 — the
# 3x ASR latency penalty (5.5s → 16s on a 5s utterance) far
# outweighs the marginal Cantonese quality gain. Layer 2
# (Cantonese fine-tune of base) is the actual path forward.
backend = "whisper_local"             # v1: "whisper_local" is the only one wired in the factory
model_size = "base"                   # tiny/base/small/medium/large
device = "auto"                       # auto | cpu | mps (Apple Silicon)

[voice.tts]
backend = "edge"                      # edge (free) | pyttsx3 (offline)
voice = "zh-HK-HiuMaanNeural"         # Cantonese-leaning
# See: https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support
# Common voices: zh-CN-XiaoxiaoNeural, en-US-JennyNeural, ja-JP-NanamiNeural

[voice.live2d]
enabled = true
theme = "ntd"                         # ntd | seedfreedom | ... (more later)
default_emotion = "calm"
# Path to a Cubism .model3.json (leave empty to use the CSS avatar fallback)
model_path = ""

# ---------------------------------------------------------------------------
# Mark-XL tool imports (Sprint 27, see
# docs/FEATURE-SPEC-SPRINT27.md; Sprint 28/29 wired
# the conditional registration per
# docs/FEATURE-SPEC-SPRINT28.md). The 4 tools below
# are conditionally registered in `default_tools()`
# based on the `enabled` flag. Setting `enabled =
# false` removes the tool from the LLM's tool list
# (the LLM cannot call a tool it doesn't know about).
#
# **NOTE: changes to `enabled` take effect on
# backend restart.** The `ToolsConfig.enabled` flag
# is not runtime-tunable in v0.1.5+; a future sprint
# can add hot-reload via the existing
# `schedule_restart` pattern (Sprint 19b).
# ---------------------------------------------------------------------------

# WebSearchTool (Track 27.1) — DuckDuckGo HTML search.
# No extra dep needed (uses existing httpx).
[tools.web_search]
enabled = true
# Cap on results fetched from DDG (1-10). Default 5.
max_results = 5
# Cap on the formatted output length (chars) to keep
# the TTS response under the 60s budget. Default 800.
summary_max_chars = 800
# HTTP timeout for the DDG endpoint. Default 10s.
request_timeout_s = 10.0

# YouTubeSummarizeTool (Track 27.2) — fetch + summarize
# a YouTube video's transcript.
# Requires the optional `youtube-transcript-api` dep:
#   uv add youtube-transcript-api
# Without the dep, the tool falls back to YouTube's
# oEmbed API and returns the video's title + author.
[tools.youtube_summarize]
enabled = true
# Cap on transcript length before LLM summarisation.
# Default 12000 (matches Mark-XL).
max_transcript_chars = 12000
# Cap on the formatted output length (chars).
summary_max_chars = 800

# FlightFinderTool (Track 27.3) — Google Flights
# URL builder. Returns a URL the user opens in their
# browser; doesn't extract flight data. See the spec
# §4.2 for why this is a stub, not a full extractor.
# No extra dep needed.
[tools.flight_finder]
enabled = true
# No config fields yet — the tool builds a clean
# Google Flights URL from origin/destination/date.

# SendMessageTool (Track 27.4) — pyautogui-based
# message sender. **OPT-IN**: requires the
# `pyautogui + pyperclip` deps AND macOS Accessibility
# permission. The tool is a stub in v0.1.5+ — it
# returns a clear "not yet implemented" message. The
# full pyautogui flow is a future sprint.
#   uv add pyautogui pyperclip
[tools.send_message]
enabled = false  # OPT-IN: pyautogui is fragile
# OS family (auto-detected from sys.platform by default;
# uncomment to override):
# os_system = "darwin"  # darwin | win32 | linux
# Default messaging platform when none is specified.
default_platform = "whatsapp"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
[security]
audit_log = "~/.gundam-halo/logs/audit.log"
audit_max_size_mb = 100
injection_scan = true                 # scan inbound text for prompt injection
